{
  "manifest_version": 3,
  "name": "EcoSalva — Reutilizar WhatsApp Web",
  "version": "1.1.0",
  "description": "Encaminha mensagens do cronograma para a aba existente do WhatsApp Web.",
  "permissions": [
    "tabs"
  ],
  "host_permissions": [
    "https://web.whatsapp.com/*",
    "https://firemanbr.github.io/*"
  ],
  "content_scripts": [
    {
      "matches": [
        "https://firemanbr.github.io/*"
      ],
      "js": [
        "content.js"
      ],
      "run_at": "document_start"
    },
    {
      "matches": [
        "https://web.whatsapp.com/*"
      ],
      "js": [
        "whatsapp-content.js"
      ],
      "run_at": "document_idle"
    }
  ],
  "background": {
    "service_worker": "background.js"
  }
}